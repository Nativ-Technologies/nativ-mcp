{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nativ": {
      "type": "streamable-http",
      "url": "https://mcp.usenativ.com/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "nativ-chatgpt-plugin",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "nativ:localize"
            ]
          }
        }
      }
    }
  }
}
